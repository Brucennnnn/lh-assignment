# Copy to .env and fill in. .env is gitignored; never commit real keys.
OPENAI_API_KEY=sk-your-key-here

# Models
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Retrieval tuning (cosine similarity of the best-matching chunk)
TOP_K=4
CHUNK_SIZE=700
SCOPE_THRESHOLD=0.20
RETRIEVAL_THRESHOLD=0.32

# Set to 1 to also print the JSON request log to stdout
LOG_STDOUT=0
