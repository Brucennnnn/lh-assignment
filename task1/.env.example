# Copy to .env and fill in. .env is gitignored; never commit real keys.
OPENAI_API_KEY=sk-your-key-here

# Models
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Retrieval tuning. RETRIEVAL_THRESHOLD is the evidence threshold: below it we
# hold no document covering the question, so the answer is a fallback. It is the
# only score-based decision in the pipeline - scope does not use scores.
TOP_K=4
CHUNK_SIZE=700
RETRIEVAL_THRESHOLD=0.32

# Set to 1 to also print the JSON request log to stdout
LOG_STDOUT=0

# Where the index and the request log live. Defaults are fine.
# INDEX_PATH=data/index.pkl
# LOG_PATH=logs/rag.jsonl
